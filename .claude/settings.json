{
    "permissions": {
      "allow": [
        "Bash(npm run dev)",
        "Bash(npm test)",
        "Bash(npm run build)",
        "Bash(npm run lint)",
        "Bash(npm run type-check)",
        "Bash(git *)",
        "Bash(npx supabase *)",
        "Bash(supabase *)"
      ],
      "deny": [
        "Bash(rm -rf *)",
        "Bash(sudo *)"
      ]
    },
    "hooks": {
      "PreToolUse": [
        {
          "matcher": "Bash",
          "hooks": [
            {
              "type": "command",
              "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-dangerous-git.sh"
            }
          ]
        }
      ],
      "PostToolUse": [
        {
          "matcher": "Edit|Write|MultiEdit",
          "hooks": [
            {
              "type": "command",
              "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit-typecheck.sh"
            }
          ]
        }
      ]
    }
  }