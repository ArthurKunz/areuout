# Kopiervorlage für .env.local (Entwicklung) und für die Environment Variables in
# Vercel (Produktion). Die echten Werte gehören NICHT ins Repository.

# --- Supabase ---------------------------------------------------------------
# Beide stehen im Supabase-Dashboard unter Settings -> API.
# Der anon-Key landet im Browser-Bundle. Das ist so vorgesehen: geschützt wird
# nicht durch Geheimhaltung des Keys, sondern durch Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://<projekt-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# --- Google Maps ------------------------------------------------------------
# Für die Kartenvorschau (Static Maps API). Steht ebenfalls im Browser-Bundle und
# lässt sich deshalb nur über Beschränkungen in der Google Cloud Console schützen:
#   1. Anwendungsbeschränkung: HTTP-Referrer -> die eigene Domain
#   2. API-Beschränkung: ausschließlich "Maps Static API"
#   3. Budget-Alert auf dem Rechnungskonto
# Ohne diese drei kann jeder den Key aus der Seite kopieren und auf die eigene
# Rechnung nutzen.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=<maps-key>

# --- Eigene Adresse ---------------------------------------------------------
# Nur nötig, sobald eine eigene Domain existiert. Ohne diesen Wert nimmt die App
# automatisch die Produktionsdomain von Vercel (siehe lib/site.ts) - Vorschauen
# und Sitemap stimmen also auch vorher schon.
# Mit https:// davor und ohne abschliessenden Schraegstrich. Beides raeumt
# lib/site.ts inzwischen selbst auf, falls es doch anders eingetragen wird.
NEXT_PUBLIC_SITE_URL=https://deine-domain.de

# --- Bewusst NICHT hier -----------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY wird im gesamten Quellcode nirgends verwendet. Er
# gehört deshalb auch nicht in die Vercel-Konfiguration: was nicht deployt ist,
# kann nicht versehentlich in einem Client-Import landen.
