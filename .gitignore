# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...ausser der Kopiervorlage: die enthaelt keine Werte, sondern erklaert, welche
# Variablen gesetzt sein muessen und warum.
!.env.example

# maplibre worker, copied from node_modules before every dev and build run
/public/maplibre/

# Playwright MCP screenshots and logs from local test runs
/.playwright-mcp/

# vercel
.vercel

# claude local settings (contains secrets)
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts
